# Copy to .env and fill in.
#
# The only setting you need is NAI_KEY. Everything below it has a working
# default.

# Your NovelAI persistent API token.
# NovelAI -> User Settings -> Account -> Get Persistent API Token.
NAI_KEY=

# Server stuffs


PORT=8744

# 127.0.0.1 means only this machine can reach it, which is what you want unless
# you are deliberately reaching it from another device on your own network.
HOST=127.0.0.1


# Sign-in - optional


# Leave this section empty and there is no sign-in screen: the app is yours and
# binds to localhost only.

# Set a password to require one before the app loads. Worth doing if you set
# HOST above to anything other than 127.0.0.1.
APP_PASSWORD=

# Or sign in with your own Discord account instead of a password. Off by
# default. DISCORD_USER_ID is the single account allowed in - yours.
OAUTH_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8744/auth/callback

# Your own Discord ID - an 18-19 digit number, not a username.
# Settings -> Advanced -> Developer Mode, then right-click your avatar -> Copy User ID.
DISCORD_USER_ID=


# Storage


# Where generated images are saved.
IMAGES_DIR=images

# Log each NovelAI request to the console.
LOG_REQUESTS=true
